# Non-secret local development configuration template.
# Copy to tenants/<configuration-name>/.env.dev or .env.prod locally.
# One configured tenant is sufficient. Do not commit secret keys.

# Environment Selector: 'dev' or 'prod'
APP_ENV=dev
DATABASE_BACKEND=azure_sql
APP_NAME=ai-search-app
LOG_LEVEL=INFO
TENANT_ID=jhu-dev

# Model profiles. Values are deployment names, not hardcoded model names.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_FLASH_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_THINKING_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_API_VERSION=2024-10-21
JHU_LLM_ENDPOINT=
JHU_LLM_USERNAME=
JHU_LLM_PASSWORD=
# Enable HTTP only for the deliberately selected JHU VPN/protected network.
JHU_LLM_ALLOW_HTTP=false
JHU_LLM_VPN_INTERFACE=OpenVPN
# Set only after probe_jhu_model.py succeeds for this exact model.
JHU_LLM_VERIFIED_MODEL=
AZURE_KEY_VAULT_SECRET_JHU_LLM_USERNAME=
AZURE_KEY_VAULT_SECRET_JHU_LLM_PASSWORD=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_PROVIDER=azure_openai
LLM_PROVIDER=azure_openai
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_MODEL_REVISION=1
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
AZURE_OPENAI_EMBEDDING_QUERY_PREFIX=
AZURE_OPENAI_EMBEDDING_DOCUMENT_PREFIX=

# Secrets should come from Key Vault or local untracked .env only.
AZURE_OPENAI_API_KEY=
JWT_SECRET=
LEGACY_PASSWORD_SECRET=

# Azure SQL Database (Microsoft SQL Server)
AZURE_SQL_HOST=
AZURE_SQL_PORT=1433
AZURE_SQL_DB=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# PostgreSQL Database (dev: ai_search_dev, prod: ai_search_prod)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# Blob storage (dev: dolphin-originals-dev, prod: dolphin-originals)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_ORIGINALS=
AZURE_BLOB_CONTAINER_ARTIFACTS=

# Existing resource targets for read-only release plans / guarded Apply.
AZURE_RESOURCE_GROUP=
AZURE_CONTAINER_REGISTRY=
AZURE_CONTAINER_APP_NAME=
AZURE_SWA_USER_NAME=
AZURE_SWA_ADMIN_NAME=

# Optional Key Vault secret names, never values.
AZURE_KEY_VAULT_NAME=
AZURE_KEY_VAULT_SECRET_SQL_PASSWORD=
AZURE_KEY_VAULT_SECRET_OPENAI_KEY=
AZURE_KEY_VAULT_SECRET_STORAGE_CONNSTR=
AZURE_KEY_VAULT_SECRET_POSTGRES_PASSWORD=
AZURE_KEY_VAULT_SECRET_JWT_SIGNING_KEY=
AZURE_KEY_VAULT_SECRET_JWT_SIGNING_KEY_VERSION=
AZURE_KEY_VAULT_SECRET_LEGACY_PASSWORD=

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=
