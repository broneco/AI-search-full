# Non-secret local development configuration template.
# Copy to .env.dev or .env.prod locally. Do not commit secret keys.

# Environment Selector: 'dev' or 'prod'
APP_ENV=dev
APP_NAME=ai-search-app
LOG_LEVEL=INFO
TENANT_ID=jhu-dev

# Model profiles. Values are deployment names, not hardcoded model names.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_FLASH_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_THINKING_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Secrets should come from Key Vault or local untracked .env only.
AZURE_OPENAI_API_KEY=

# Azure SQL Database (Microsoft SQL Server)
AZURE_SQL_HOST=
AZURE_SQL_PORT=1433
AZURE_SQL_DB=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# PostgreSQL Database (dev: ai_search_dev, prod: ai_search_prod)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# Blob storage (dev: dolphin-originals-dev, prod: dolphin-originals)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_ORIGINALS=
AZURE_BLOB_CONTAINER_ARTIFACTS=

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=
