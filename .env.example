# Non-secret local development configuration template.
# Copy to .env locally. Do not commit .env.

APP_ENV=local
APP_NAME=ai-search-app
LOG_LEVEL=INFO

# Model profiles. Values are deployment names, not hardcoded model names.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_FLASH_DEPLOYMENT=
AZURE_OPENAI_THINKING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Secrets should come from Key Vault or local untracked .env only.
AZURE_OPENAI_API_KEY=

# PostgreSQL. Prefer managed identity later; local spike may use password auth.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# Blob storage
AZURE_STORAGE_ACCOUNT=
AZURE_BLOB_CONTAINER_ORIGINALS=
AZURE_BLOB_CONTAINER_ARTIFACTS=

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=
